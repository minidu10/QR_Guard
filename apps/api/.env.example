# Copy to .env for local dev without Docker.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/qrguard
REDIS_URL=redis://localhost:6379

# MinIO locally, AWS S3 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=qrguard
S3_FORCE_PATH_STYLE=true

AI_SERVICE_URL=http://localhost:8000

# Auth. Make each secret a long random string, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Password for the demo users made by `pnpm --filter api seed`.
SEED_PASSWORD=change-me-demo-password
