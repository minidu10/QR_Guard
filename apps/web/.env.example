# Copy to .env.local for local dev without Docker.
# URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:4000
# URL the browser uses for live updates (Socket.io). Must be reachable from the user's device.
API_PUBLIC_URL=http://localhost:4000
# Send cookies only over HTTPS. Leave unset to use "true" in production builds.
# Set to false only for plain-http local testing.
# COOKIE_SECURE=false
