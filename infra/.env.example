# Copy to infra/.env and change the values. Never commit infra/.env.

# Local PostgreSQL (used when DATABASE_URL is empty).
POSTGRES_USER=qrguard
POSTGRES_PASSWORD=change-me-please
# Port on your computer. Use another one (e.g. 55432) if PostgreSQL is already installed on your PC.
POSTGRES_PORT=5432

# Supabase (optional). Leave empty to use the local database above.
# Supabase dashboard -> Connect. Add ?sslmode=require&uselibpqcompat=true at the end.
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true
# No IPv6 on your network? Use the "Session pooler" string from the same page instead.
# DIRECT_URL=
MINIO_ROOT_USER=qrguard
MINIO_ROOT_PASSWORD=change-me-please
S3_BUCKET=qrguard
CORS_ORIGIN=http://localhost:3000
# Where browsers reach the API for live updates.
API_PUBLIC_URL=http://localhost:4000
# AI tamper check: real = trained model in apps/ai-service/models, mock = fixed answers.
MODEL_MODE=real

# Auth secrets: long random strings, different from each other.
# Make one with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Payment drop check: alert when the last hour has fewer than DROP_RATIO x normal payments
# (normal = same hour over DROP_LOOKBACK_DAYS days, and at least DROP_MIN_NORMAL payments).
DROP_RATIO=0.4
DROP_MIN_NORMAL=5
DROP_LOOKBACK_DAYS=7
# Cron syntax. Empty = every 15 minutes.
DROP_CHECK_CRON=
# Demo only: fake payments keep coming in live. Set false for real data.
PAYMENT_SIMULATOR=true

# Password for the demo users made by the seed script.
SEED_PASSWORD=

# Plain http locally, so cookies cannot be "secure". Set true behind HTTPS.
COOKIE_SECURE=false
